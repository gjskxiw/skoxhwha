*.log

# ---- 本地编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ---- 环境变量与凭据 ----
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# ---- 本仓库根的临时/散落文件 ----
*.pdb

# ---- 本地工作产物（不属于项目源码，不要提交）----
